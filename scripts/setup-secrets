#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
umask 077
if [ ! -e .env ]; then
    temporary=$(mktemp .env.XXXXXX)
    trap 'rm -f "$temporary"' EXIT
    for name in POSTGRES_PASSWORD SECRET_KEY_BASE PORTFOLIO_ADMIN_PASSWORD \
        PORTFOLIO_LEAD_GEO_PASSWORD PORTFOLIO_MEMBER_GEO_PASSWORD \
        PORTFOLIO_READER_GEO_PASSWORD PORTFOLIO_LEAD_IT_PASSWORD PORTFOLIO_NONMEMBER_PASSWORD; do
        value=$(openssl rand -hex 32)
        printf '%s=%s\n' "$name" "$value"
    done > "$temporary"
    ln "$temporary" .env
fi
chmod 600 .env
